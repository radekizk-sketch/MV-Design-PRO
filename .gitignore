mv-design-pro/backend/.station_templates/

# CI render artifacts (generated by sld_render_artifacts.ts)
mv-design-pro/artifacts/

# Zrzuty ekranów kreatorów (artefakty regenerowalne przez e2e/creator-screenshot.spec)
# Zrzuty scen (V12K-259): 70 plikow odtwarzanych jedna komenda
# (`npx playwright test e2e/wszystkie-sceny-screenshot.spec.ts`), wiec nie trzymamy ich
# w repozytorium — tak samo jak pozostalych kadrow kreatorow. Generator galerii mowi
# wprost, ktorego pliku brakuje, zamiast po cichu wypuscic niepelna strone.
mv-design-pro/docs/audit/visual/sceny/*.png
mv-design-pro/docs/audit/visual/kreatory/*.png
mv-design-pro/docs/audit/visual/dokumentacja/*.png
# WYJĄTEK: zrzuty pokazywane w NARRACJI strony oceny (`generuj_strone_oceny.py` odwołuje
# się do nich ścieżką względną, a w trybie `--osadz` wstawia jako data URI). Gdyby były
# ignorowane, po cofnięciu migawki kontenera narracja odsyłałaby do plików, których nie ma
# — czyli reguła kasowałaby to, czego generator w repo miał pilnować.
!mv-design-pro/docs/audit/visual/kreatory/wiazania_oze*.png

# Artefakty przebiegu Playwrighta — stan ostatniego uruchomienia, nie kod projektu.
mv-design-pro/test-results/

# Strona oceny — WYNIK generatora `generuj_strone_oceny.py` (skan katalogu, KD-13).
# Źródłem prawdy jest generator + zrzuty w repo, nie ten plik; po cofnięciu migawki
# kontenera stronę odtwarza jedno uruchomienie.
mv-design-pro/docs/audit/visual/ocena_seria.html
# Galeria ekranów — WYNIK `generuj_galerie_ekranow.py` (7,5 MiB zrzutów jako data URI).
# Ta sama zasada, co wyżej: w repo trzymamy generator, nie jego wydruk. Reguła brakowała
# od V12K-259 — plik był nietrackowany tylko dlatego, że nikt go nie dodał.
mv-design-pro/docs/audit/visual/galeria_ekranow.html
