  "portTransformations": {
    "description": "How to transform port coordinates for rotations",
    "rotation_90": {
      "formula": "new_x = 100 - y, new_y = x",
      "portMapping": {
        "top": "right",
        "right": "bottom",
        "bottom": "left",
        "left": "top"
      }
    },
    "rotation_180": {
      "formula": "new_x = 100 - x, new_y = 100 - y",
      "portMapping": {
        "top": "bottom",
        "right": "left",
        "bottom": "top",
        "left": "right"
      }
    },
    "rotation_270": {
      "formula": "new_x = y, new_y = 100 - x",
      "portMapping": {
        "top": "left",
        "right": "top",
        "bottom": "right",
        "left": "bottom"
      }
    }
  }
