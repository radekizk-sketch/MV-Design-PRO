{
  "name": "mv-design-pro-frontend",
  "version": "0.1.0",
  "description": "MV-DESIGN PRO - Frontend Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run --no-file-parallelism",
    "test:ci": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "accept:sld-v3": "vite-node scripts/sld_v3_acceptance.mjs",
    "test:e2e": "node ./scripts/playwright-run.mjs",
    "test:e2e:setup": "node ./scripts/playwright-setup.mjs",
    "test:e2e:ui": "node ./scripts/playwright-run.mjs --ui",
    "type-check": "tsc --noEmit",
    "guard:codenames": "node ./scripts/run-python.mjs ../scripts/no_codenames_guard.py",
    "guard:ui-terminology": "node ./scripts/run-python.mjs ../scripts/ui_terminology_guard.py",
    "guard:docs-archive": "node ./scripts/run-python.mjs ../scripts/docs_archive_guard.py",
    "guard:v12xx-canon": "node ./scripts/run-python.mjs ../scripts/v12xx_canon_guard.py",
    "guard:import-graph": "node ./scripts/run-python.mjs ../scripts/import_graph_guard.py",
    "guard:grep-zero": "node ./scripts/run-python.mjs ../scripts/grep_zero_guard.py",
    "guard:vulture": "node ./scripts/run-python.mjs ../scripts/vulture_guard.py",
    "test:e2e:bootstrap": "npm ci && npm run test:e2e:setup",
    "test:e2e:setup:real": "cd ../backend && poetry install --with dev && cd ../frontend && npm run test:e2e:setup",
    "test:e2e:real": "node ./scripts/playwright-run-real.mjs e2e/critical-run-flow.spec.ts e2e/critical-oze-evidence.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.6.5",
    "clsx": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "katex": "^0.16.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "react-router-dom": "^6.21.3",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/katex": "^0.16.7",
    "@types/node": "^25.2.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.2",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
