{
  "$defs": {
    "KanalDynamicznyV2": {
      "additionalProperties": false,
      "description": "Opis jednego kanalu szeregu czasowego (bez probek — te w API na zadanie).",
      "properties": {
        "element_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ref_id elementu ENM, gdy dotyczy.",
          "title": "Element Ref"
        },
        "jednostka": {
          "description": "Jednostka fizyczna (pu, Hz, s, MW, Mvar...).",
          "minLength": 1,
          "title": "Jednostka",
          "type": "string"
        },
        "klucz": {
          "description": "Klucz kanału (np. 'u_pu@b12', 'omega_pu@g1').",
          "minLength": 1,
          "title": "Klucz",
          "type": "string"
        },
        "opis_pl": {
          "description": "Opis po polsku (bez kodów projektowych).",
          "minLength": 1,
          "title": "Opis Pl",
          "type": "string"
        },
        "przestrzen": {
          "enum": [
            "siec",
            "urzadzenie",
            "regulator",
            "magazyn",
            "obserwabla"
          ],
          "title": "Przestrzen",
          "type": "string"
        }
      },
      "required": [
        "klucz",
        "przestrzen",
        "jednostka",
        "opis_pl"
      ],
      "title": "KanalDynamicznyV2",
      "type": "object"
    },
    "MetrykaDynamicznaV2": {
