    "PrzekroczenieV2": {
      "additionalProperties": false,
      "description": "Chwila przekroczenia progu przez wielkosc DETEKTORA scenariusza (bez akcji).",
      "properties": {
        "dozor": {
          "description": "Identyfikator detektora ze scenariusza.",
          "minLength": 1,
          "title": "Dozor",
          "type": "string"
        },
        "iteracje": {
          "description": "Liczba prób kroku lokalizacji.",
          "minimum": 0,
          "title": "Iteracje",
          "type": "integer"
        },
        "kierunek": {
          "enum": [
            "w_dol",
            "w_gore"
          ],
          "title": "Kierunek",
          "type": "string"
        },
        "prog": {
          "description": "Próg w jednostce kanału.",
          "title": "Prog",
          "type": "number"
        },
        "szerokosc_przedzialu_s": {
          "description": "Szerokosc przedziału lokalizacji (0 dla chwili zdarzenia).",
          "minimum": 0.0,
          "title": "Szerokosc Przedzialu S",
          "type": "number"
        },
        "t_s": {
          "description": "Chwila przekroczenia (strona po przekroczeniu). Czas skwantyzowany do 9 cyfr znaczacych na granicy kontraktu (rozdzielczosc publikacji); chwile zdarzeń warunkowych rdzeń lokalizuje z tolerancja z nastaw solvera w pełnej precyzji.",
          "title": "T S",
          "type": "number"
        },
        "wielkosc": {
          "description": "Klucz kanału wyniku, który detektor czyta (ta sama funkcja).",
          "minLength": 1,
          "title": "Wielkosc",
          "type": "string"
        }
      },
      "required": [
        "dozor",
        "wielkosc",
        "prog",
        "kierunek",
        "t_s",
        "szerokosc_przedzialu_s",
        "iteracje"
      ],
      "title": "PrzekroczenieV2",
      "type": "object"
    },
    "PrzypisanieWykonaneV2": {
