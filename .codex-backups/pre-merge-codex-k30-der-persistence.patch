+        { key: 'bay', label: 'Pole / tor', value: bayLabel },
+        { key: 'role', label: 'Rola techniczna', value: isPvConnection ? 'Przyłączenie źródła' : 'Tor pierwotny stacji' },
+      ],
+    },
+  ];
+
+  return {
+    sections,
+    elementType: selectedElement.type,
+    elementName: selectedElement.name,
+    actions: [],
+  };
